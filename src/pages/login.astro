---
import Base from '../layouts/Base.astro';
import { safeReturn } from '../lib/security';
const returnTo = safeReturn(Astro.url.searchParams.get('returnTo'));
if (Astro.locals.user) return Astro.redirect(returnTo);
const providers = [
  ['github', 'GitHub'],
  ['google', 'Google'],
].filter(
  ([id]) => process.env[id.toUpperCase() + '_CLIENT_ID'] && process.env[id.toUpperCase() + '_CLIENT_SECRET'],
);
---

<Base title="로그인" noindex
  ><section class="auth-panel">
    <div class="eyebrow">WELCOME BACK, BUILDER.</div><h1 style="margin-top:14px">다시, 만들어볼 시간.</h1><p
      class="muted"
    >
      내 도구와 제작 이야기를 이어가세요.
    </p>{
      Astro.url.searchParams.has('error') && (
        <p class="form-status error" role="alert">
          소셜 로그인을 완료하지 못했어요. 이메일 계정이 있다면 이메일로 로그인해 주세요.
        </p>
      )
    }{
      Astro.url.searchParams.has('updated') && (
        <p class="form-status">비밀번호를 변경했어요. 다시 로그인해 주세요.</p>
      )
    }<form data-api action="/api/auth/login" method="post">
      <input type="hidden" name="csrf" value={Astro.locals.csrf} /><input
        type="hidden"
        name="returnTo"
        value={returnTo}
      /><label class="form-field"
        ><span>이메일</span><input
          name="email"
          type="email"
          autocomplete="email"
          required
          maxlength="254"
        /></label
      ><label class="form-field"
        ><span>비밀번호</span><input
          name="password"
          type="password"
          autocomplete="current-password"
          required
          maxlength="128"
        /></label
      ><button type="submit" class="primary">로그인 ↗</button><p class="form-status" role="status"></p>
    </form><div class="auth-links">
      <a href="/forgot">비밀번호를 잊으셨나요?</a><a href={'/signup?returnTo=' + encodeURIComponent(returnTo)}
        >회원가입 ↗</a
      >
    </div><div class="auth-divider">
      {
        providers.length ? (
          providers.map(([id, label]) => (
            <a
              class="button secondary"
              style="width:100%;margin-bottom:10px"
              href={'/auth/' + id + '?returnTo=' + encodeURIComponent(returnTo)}
            >
              {label}로 계속하기
            </a>
          ))
        ) : (
          <p class="muted small">
            소셜 로그인은 준비 중이에요. 이메일로 가입하고 모든 기본 기능을 이용할 수 있어요.
          </p>
        )
      }
    </div>
  </section></Base
>
