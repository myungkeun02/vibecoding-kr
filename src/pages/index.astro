---
import Base from '../layouts/Base.astro';
import Directory from '../components/Directory.astro';
import Ticker from '../components/Ticker.astro';
import Newsletter from '../components/Newsletter.astro';
import { apps, filterApps } from '../lib/apps';
import { absolute, boards } from '../lib/config';
import { posts, voteCounts } from '../lib/db';
const recent = posts(new URLSearchParams()).items.slice(0, 3);
const r = filterApps(Astro.url.searchParams, voteCounts());
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: '바이브코딩가능?',
    url: absolute('/'),
    potentialAction: {
      '@type': 'SearchAction',
      target: absolute('/?q={search_term_string}'),
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: r.items.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.name,
      url: absolute('/' + a.slug),
    })),
  },
];
---

<Base title="이 도구, 바이브코딩으로 대체할 수 있을까?" {jsonld} noindex={Astro.url.search.length > 0}
  ><section class="hero">
    <div>
      <div class="eyebrow"><span class="status-dot"></span> 필요한 기능부터, 직접 만들어보세요</div><h1>
        이 도구,<br /><span class="accent">직접 만들 수 있을까?</span>
      </h1><p>
        매일 쓰는 기능만 골라, 나만의 도구로.<br />어디까지 만들 수 있는지 살펴보고, 프롬프트로 시작해 보세요.
      </p><form action="/" role="search">
        <label class="search-box"
          ><span aria-hidden="true">&gt;</span><input
            id="search"
            name="q"
            aria-label="도구 검색"
            placeholder={`노션, 엑셀, 옵시디언… ${apps.length}개 도구 검색`}
            value={Astro.url.searchParams.get('q') || ''}
            autocomplete="off"
          /><kbd aria-hidden="true">/</kbd></label
        >
      </form>
    </div><aside>
      <div class="terminal">
        <div class="cmd">&gt; 어디까지 만들 수 있을까요?</div><strong
          >완벽한 복제보다, 필요한 기능부터.</strong
        ><br />만들 수 있는 기능과 어려운 부분을 함께 살펴봐요.
      </div><div style="margin-top:17px">
        {
          [
            ['yes', '대체 가능', '정해진 범위는 직접 만들 만해요'],
            ['kinda', '일부 대체 가능', '기존 도구와 함께 써야 해요'],
            ['no', '대체 어려움', '핵심 기능까지 만들기는 어려워요'],
          ].map(([v, en, ko]) => (
            <div class="legend-row">
              <>
                <span class:list={['verdict', v]} style="font-size:12px">
                  <i class="dot" />
                  {en}
                </span>
                <span class="muted small">{ko}</span>
              </>
            </div>
          ))
        }
      </div><div class="eyebrow" style="margin-top:17px">
        도구 {apps.length}개 · 분야 15개 · 다음 만들거리를 찾아보세요
      </div>
    </aside>
  </section><Ticker /><Directory /><div class="home-bottom">
    <section>
      <div class="flex between">
        <h2>직접 만들어본 이야기</h2><a class="small muted" href="/community">커뮤니티 전체 ↗</a>
      </div>{
        recent.map((p) => (
          <a class="post-preview" href={'/community/' + p.id}>
            <>
              <span class="eyebrow">{boards[p.board]}</span>
              <h3>{p.title}</h3>
              <p>
                {p.nickname || '탈퇴한 사용자'} · 댓글 {p.comments}
              </p>
            </>
          </a>
        ))
      }{
        !recent.length && (
          <div class="empty">
            <>
              <div class="mono accent">[ 여러분의 첫 작품을 기다려요 ]</div>
              <h3 style="margin-top:16px">첫 번째 제작 이야기를 기다려요.</h3>
              <p>작은 성공도, 막혔던 부분도 다음에 만들 사람에게 도움이 됩니다.</p>
              <a href="/community/new" class="button secondary">
                제작 후기 남기기 ↗
              </a>
            </>
          </div>
        )
      }
    </section><Newsletter />
  </div></Base
>
