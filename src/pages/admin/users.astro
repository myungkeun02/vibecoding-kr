---
import Layout from '../../layouts/admin/Layout.astro';
import Pagination from '../../components/admin/Pagination.astro';
import Action from '../../components/admin/Action.astro';
import { listRecords } from '../../admin/data';
import { statusLabels } from '../../admin/labels';
const r = await listRecords('users', Astro.url.searchParams);
---

<Layout title="회원 관리" section="users"
  ><p class="admin-help">
    가입 현황을 확인하고 이용 제한·세션 종료를 처리합니다. 관리자 권한은 별도 메뉴에서 관리합니다.
  </p><details class="admin-panel">
    <summary>회원 직접 추가</summary><p class="admin-help">
      이메일·비밀번호 계정을 만듭니다. 관리자 권한이나 이메일 확인 상태는 자동으로 부여하지 않습니다.
    </p><form class="admin-form-two" data-admin-form action="/api/admin/v1/users" method="post">
      <input type="hidden" name="csrf" value={Astro.locals.csrf} /><label class="form-field"
        ><span>이메일</span><input type="email" name="email" required maxlength="254" /></label
      ><label class="form-field"
        ><span>닉네임</span><input name="nickname" required minlength="2" maxlength="24" /></label
      ><label class="form-field wide"
        ><span>초기 비밀번호</span><input
          type="password"
          name="password"
          required
          minlength="10"
          maxlength="128"
          autocomplete="new-password"
        /></label
      ><div class="wide">
        <button class="button primary" type="submit">회원 추가</button><p class="form-status" role="status">
        </p>
      </div>
    </form>
  </details><form class="admin-toolbar" action="/users">
    <input
      type="search"
      name="q"
      aria-label="회원 검색"
      placeholder="이메일 또는 닉네임"
      value={Astro.url.searchParams.get('q') || ''}
    /><select name="status" aria-label="회원 상태"
      ><option value="">상태 전체</option>{
        ['active', 'suspended'].map((s) => (
          <option value={s} selected={Astro.url.searchParams.get('status') === s}>
            {statusLabels[s]}
          </option>
        ))
      }</select
    ><button type="submit" class="button secondary">검색</button>
  </form><div class="admin-table-wrap">
    <table class="admin-table">
      <thead><tr><th>회원</th><th>상태</th><th>가입일</th><th>관리</th></tr></thead><tbody
        >{
          r.items.map((u) => (
            <tr data-user-id={u.id}>
              <>
                <td class="cell-main">
                  <>
                    <strong>{u.nickname}</strong>
                    <p class="small muted">{u.email}</p>
                    <p class="small">
                      {u.email_verified_at ? '이메일 확인됨' : '이메일 미확인'}
                      {u.admin_role && ' · 관리자'}
                    </p>
                  </>
                </td>
                <td>{statusLabels[u.status]}</td>
                <td>{u.created_at.slice(0, 10)}</td>
                <td>
                  <div class="admin-actions">
                    {!u.admin_role && u.id !== Astro.locals.admin!.user_id && (
                      <Action
                        path={'users/' + u.id + '/status'}
                        label={u.status === 'active' ? '이용 제한' : '제한 해제'}
                        fields={{ status: u.status === 'active' ? 'suspended' : 'active' }}
                        confirm={
                          u.status === 'active'
                            ? '이 회원의 이용을 제한하고 모든 서비스 세션을 종료할까요?'
                            : undefined
                        }
                      />
                    )}
                    <Action
                      path={'users/' + u.id + '/sessions'}
                      label="전체 로그아웃"
                      confirm="이 회원의 모든 서비스 로그인 세션을 종료할까요?"
                    />
                  </div>
                </td>
              </>
            </tr>
          ))
        }</tbody
      >
    </table>{!r.items.length && <p class="admin-empty">검색 결과가 없습니다.</p>}
  </div><Pagination result={r} base="/users" /></Layout
>
