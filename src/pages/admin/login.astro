---
import Layout from '../../layouts/admin/Layout.astro';
if (Astro.locals.admin) return Astro.redirect('/');
const errors: Record<string, string> = {
  rate: '로그인 요청이 많습니다. 잠시 후 다시 시도해 주세요.',
  denied: '이 Google 계정에는 관리자 권한이 없습니다. 권한이 부여된 계정을 선택해 주세요.',
  oauth: 'Google 로그인을 완료하지 못했습니다. 다시 시도해 주세요.',
  unavailable: '관리자 Google 로그인 설정을 확인하고 있습니다.',
};
---

<Layout title="관리자 로그인" guest
  ><section class="admin-login">
    <img src="/brand/vibepan-robot-128.webp" width="80" height="80" alt="바이브판" /><h2>
      운영 계정으로 로그인
    </h2><p>권한이 부여된 Google 계정만 접속할 수 있습니다.</p>{
      Astro.url.searchParams.has('error') && (
        <p class="admin-login-error" role="alert">
          {errors[Astro.url.searchParams.get('error') || ''] || errors.oauth}
        </p>
      )
    }<a class="button primary" href="/api/admin/auth/google">Google 계정으로 로그인</a><p class="small">
      일반 서비스 로그인과 별도로 인증합니다.
    </p>
  </section></Layout
>
