if (!Astro.locals.user)
  return Astro.redirect('/login?returnTo=' + encodeURIComponent(Astro.url.pathname + Astro.url.search));
---

<Base title="이야기 작성" noindex
  ><header class="page-head">
    <div class="eyebrow">SHARE YOUR PROCESS</div><h1 style="margin-top:12px">새로운 이야기</h1><p>
      작은 시도도 누군가에겐 좋은 출발점이 됩니다.
    </p>
  </header><PostEditor /></Base
>
