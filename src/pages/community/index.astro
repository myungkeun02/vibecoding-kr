---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import Newsletter from '../../components/Newsletter.astro';
import { posts } from '../../lib/db';
import { boards } from '../../lib/config';
const r = await posts(Astro.url.searchParams);
const link = (k: string, v: string) => {
  const p = new URLSearchParams(Astro.url.searchParams);
  p.delete('page');
  v ? p.set(k, v) : p.delete(k);
  return '/community?' + p;
};
---

<Base title="만드는 사람들" noindex={Astro.url.search.length > 0}
  ><header class="page-head">
    <div class="eyebrow">만들어보고, 막혀보고, 함께 나눠요</div><div class="flex between wrap-flex">
      <h1 style="margin-top:13px">혼자 만들고, 함께 배우고.</h1><a class="button" href="/community/new"
        >이야기 남기기 +</a
      >
    </div><p>완성한 도구부터 막힌 코드까지. 직접 만드는 사람들의 이야기를 나눠요.</p>
  </header><nav class="tabs" aria-label="게시판">
    <a href="/community" class:list={{ active: !Astro.url.searchParams.get('board') }}>전체 이야기</a>{
      Object.entries(boards).map(([k, v]) => (
        <a href={link('board', k)} class:list={{ active: Astro.url.searchParams.get('board') === k }}>
          {v}
        </a>
      ))
    }
  </nav><div class="community-layout">
    <section>
      <form class="flex wrap-flex" action="/community">
        <input type="hidden" name="board" value={Astro.url.searchParams.get('board') || ''} /><input
          name="q"
          class="field grow"
          aria-label="커뮤니티 검색"
          placeholder="제목이나 내용으로 찾아보세요"
          value={Astro.url.searchParams.get('q') || ''}
        /><select name="sort" aria-label="글 정렬"
          ><option value="newest">최신순</option><option
            value="popular"
            selected={Astro.url.searchParams.get('sort') === 'popular'}>인기순</option
          ></select
        ><button class="button secondary" type="submit">검색</button>
      </form>{r.items.map((p) => <PostRow post={p} />)}{
        !r.total && (
          <div class="empty" style="margin-top:24px">
            <>
              <div class="mono accent">&gt; 새로운 이야기를 기다리는 중_</div>
              <p>궁금한 점을 묻거나, 첫 제작 후기를 남겨보세요.</p>
              <a class="button secondary" href="/community/new">
                글 작성하기 ↗
              </a>
            </>
          </div>
        )
      }<nav class="pagination" aria-label="게시글 페이지">
        {
          Array.from({ length: r.pages }, (_, i) => i + 1).map((p) => (
            <a href={link('page', String(p))} class:list={{ active: r.page === p }}>
              {p}
            </a>
          ))
        }
      </nav>
    </section><aside>
      <section class="meta-box">
        <div class="eyebrow">제작 후기를 남길 때</div><h3 style="margin-top:15px">
          결과만큼 과정도 궁금해요.
        </h3><p>어떤 기능을 만들었는지, 어디서 막혔는지, 실제로 대체한 범위를 함께 적어주세요.</p><a
          class="small accent"
          href="/community/new?board=builds">제작 후기 작성 ↗</a
        >
      </section><Newsletter />
    </aside>
  </div></Base
>
