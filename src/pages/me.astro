---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { all, postSelect } from '../lib/db';
import { getApp } from '../lib/apps';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?returnTo=/me');
const mine = all(postSelect + " WHERE p.user_id=? AND p.status='active' ORDER BY p.created_at DESC", user.id);
const comments = all(
  "SELECT c.*,p.title FROM comments c JOIN posts p ON p.id=c.post_id WHERE c.user_id=? AND c.status='active' AND p.status='active' ORDER BY c.created_at DESC",
  user.id,
);
const saved = all('SELECT slug FROM bookmarks WHERE user_id=?', user.id)
  .map((x) => getApp(x.slug))
  .filter(Boolean);
const voted = all('SELECT slug,created_at FROM votes WHERE user_id=?', user.id);
const savedPosts = all(
  postSelect +
    " JOIN reactions r ON r.post_id=p.id WHERE r.user_id=? AND r.kind='bookmark' AND p.status='active'",
  user.id,
);
const suggestions = all('SELECT * FROM suggestions WHERE user_id=? ORDER BY created_at DESC', user.id);
const labels: Record<string, string> = {
  pending: '검토 대기',
  accepted_pending_release: '채택 · 배포 대기',
  rejected: '반려',
  published: '게시 완료',
};
---

<Base title="내 활동" noindex
  ><header class="page-head">
    <div class="eyebrow">YOUR BUILDER LOG</div><h1 style="margin-top:12px">
      {user.nickname}님의 작업 기록.
    </h1><p>저장한 도구, 직접 만든 것, 함께 나눈 이야기.</p>
  </header><div class="profile-grid">
    <aside>
      <div class="meta-box">
        <p class="small">{user.email}</p>
        <p class="small">
          {
            user.email_verified_at
              ? '이메일 확인 완료 ✓'
              : '이메일 미확인 · 현재 계정은 확인 완료로 표시되지 않습니다.'
          }
        </p>
        {
          !user.email_verified_at && (
            <form data-api action="/api/auth/send-verification" method="post">
              <input type="hidden" name="csrf" value={Astro.locals.csrf} />
              <button type="submit" class="button secondary small">
                이메일 확인 메일 요청
              </button>
              <p class="form-status" role="status" />
            </form>
          )
        }
        <h2>프로필</h2><form data-api action="/api/profile/update" method="post">
          <input type="hidden" name="csrf" value={Astro.locals.csrf} /><label class="form-field"
            ><span>닉네임</span><input
              name="nickname"
              value={user.nickname}
              required
              minlength="2"
              maxlength="24"
            /></label
          ><label class="form-field"
            ><span>소개</span><textarea aria-label="소개" name="bio" maxlength="500">{user.bio}</textarea
            ></label
          ><button type="submit" class="primary">프로필 저장</button><p class="form-status" role="status"></p>
        </form><form data-api action="/api/auth/logout" method="post" style="margin-top:24px">
          <input type="hidden" name="csrf" value={Astro.locals.csrf} /><button
            class="text-button"
            type="submit">로그아웃</button
          >
        </form>
      </div><details class="meta-box">
        <summary>계정 탈퇴</summary><p style="margin-top:15px">
          작성한 글과 댓글은 삭제 상태로 전환되고, 인증·북마크·세션과 이메일 정보는 삭제됩니다.
        </p><form
          data-api
          data-confirm="정말 탈퇴할까요? 계정 정보를 복구할 수 없습니다."
          action="/api/profile/delete"
          method="post"
        >
          <input type="hidden" name="csrf" value={Astro.locals.csrf} />{
            user.password && (
              <label class="form-field">
                <>
                  <span>현재 비밀번호</span>
                  <input type="password" name="password" required autocomplete="current-password" />
                </>
              </label>
            )
          }<label class="form-field"
            ><span>확인 문구</span><input name="confirm" placeholder="탈퇴합니다" required /></label
          ><button class="button secondary danger" type="submit">계정 탈퇴</button><p
            class="form-status"
            role="status"
          >
          </p>
        </form>
      </details>
    </aside><section>
      <h2>저장한 도구 <span class="count-label">{saved.length}</span></h2><div class="tabs">
        {saved.map((a) => a && <a href={'/' + a.slug}>{a.name} ↗</a>)}
      </div>{!saved.length && <p class="muted">다음에 만들 도구를 북마크해 보세요.</p>}<div class="section">
        <h2>직접 대체한 도구</h2>{
          voted.map((v) => (
            <a class="post-preview" href={'/' + v.slug}>
              {getApp(v.slug)?.name || v.slug}
              <span class="muted small"> · {v.created_at.slice(0, 10)}</span>
            </a>
          ))
        }{!voted.length && <p class="muted">아직 대체 인증을 남기지 않았어요.</p>}
      </div><div class="section">
        <h2>내가 쓴 글</h2>{mine.map((p) => <PostRow post={p} />)}{
          !mine.length && (
            <a href="/community/new" class="button secondary">
              첫 이야기 남기기 ↗
            </a>
          )
        }
      </div><div class="section">
        <h2>내 댓글</h2>{
          comments.map((c) => (
            <a class="post-preview" href={'/community/' + c.post_id + '#comment-' + c.id}>
              <>
                <strong>{c.title}</strong>
                <p>{c.body}</p>
              </>
            </a>
          ))
        }{!comments.length && <p class="muted">아직 작성한 댓글이 없어요.</p>}
      </div><div class="section">
        <h2>저장한 글</h2>{savedPosts.map((p) => <PostRow post={p} />)}{
          !savedPosts.length && <p class="muted">다시 읽고 싶은 글을 저장해 보세요.</p>
        }
      </div><div class="section">
        <h2>내 제안</h2>{
          suggestions.map((s) => (
            <div class="post-preview">
              <>
                <strong>{s.title}</strong>
                <p>{labels[s.status] || s.status}</p>
              </>
            </div>
          ))
        }{!suggestions.length && <p class="muted">도구 등록과 정보 수정 제안이 여기에 표시돼요.</p>}
      </div>
    </section>
  </div></Base
>
