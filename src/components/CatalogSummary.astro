---
import { totals, type PublicTotals } from '../lib/db';
interface Props {
  counts?: PublicTotals;
}
const t = Astro.props.counts || (await totals());
const items = [
  { key: 'guides', label: '제작 가이드', value: t.guides, unit: '개', href: '/#directory' },
  { key: 'services', label: '등록 SaaS', value: t.services, unit: '개', href: '/services' },
  { key: 'builds', label: '제작 후기', value: t.builds, unit: '건', href: '/community?board=builds' },
];
---

<nav class="catalog-summary" aria-label="공개 콘텐츠 현황">
  {
    items.map((item) => (
      <a href={item.href} data-public-count={item.key}>
        <>
          <span>{item.label}</span>
          <strong>
            {item.value.toLocaleString('ko-KR')}
            <small>{item.unit}</small>
          </strong>
        </>
      </a>
    ))
  }
</nav>
