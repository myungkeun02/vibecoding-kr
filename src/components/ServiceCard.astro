---
import { categoryName } from '../lib/apps';
import { servicePricing, serviceStatuses } from '../lib/service-schema';
import { serviceHref, type Service } from '../lib/services';
interface Props {
  service: Service;
  showStatus?: boolean;
}
const { service: s, showStatus = false } = Astro.props;
---

<a class="service-card" href={serviceHref(s)}>
  <div class="service-card-top">
    <span class="service-initial" aria-hidden="true">{s.name.slice(0, 1)}</span>
    <div>
      <h3>{s.name}</h3><span class="small muted"
        >{categoryName(s.category)} · {servicePricing[s.pricing]}</span
      >
    </div>
    <span class="service-card-arrow" aria-hidden="true">↗</span>
  </div>
  <p>{s.tagline}</p>
  <div class="service-card-meta">
    <span>{s.guide ? '제작 가이드 있음' : '가이드 없음'}</span>{
      showStatus && <span class="accent">{serviceStatuses[s.status]}</span>
    }
  </div>
</a>
