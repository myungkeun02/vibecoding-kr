---
import Mascot from './Mascot.astro';
const { csrf } = Astro.locals;
---

<section class="newsletter">
  <div class="newsletter-heading">
    <div class="eyebrow">이메일 알림</div><Mascot size="small" />
  </div><h2 style="margin-top:12px">업데이트 소식 받기</h2><p>
    새로 추가된 도구와 제작 가이드를 이메일로 받습니다.
  </p><form data-api action="/api/waitlist" method="post">
    <input type="hidden" name="csrf" value={csrf} /><label class="honeypot" aria-hidden="true"
      >홈페이지<input name="website" tabindex="-1" autocomplete="off" /></label
    ><label class="form-field"
      ><span>이메일</span><input
        type="email"
        name="email"
        placeholder="you@example.com"
        required
        autocomplete="email"
      /></label
    ><label class="check-label"
      ><input type="checkbox" name="consent" required />업데이트 이메일 수신에 동의해요. 언제든 수신을 거부할
      수 있어요.</label
    ><button class="primary" type="submit">소식 받아보기 ↗</button><p class="form-status" role="status"></p>
  </form>
</section>
