---
import { apps, categories, filterApps } from '../lib/apps';
import { voteCounts } from '../lib/db';
import ToolRow from './ToolRow.astro';
const { params = Astro.url.searchParams } = Astro.props;
const counts = voteCounts();
const r = filterApps(params, counts);
const href = (key: string, value: string) => {
  const p = new URLSearchParams(params);
  p.delete('page');
  value ? p.set(key, value) : p.delete(key);
  return '/?' + p.toString() + '#directory';
};
---

<div class="directory-layout" id="directory">
  <aside>
    <nav class="category-nav" aria-label="도구 카테고리">
      <div class="eyebrow">EXPLORE TOOLS</div><a
        href={href('category', '')}
        class:list={{ active: !params.get('category') }}
        data-filter-link>▦ 모든 도구 <small>{apps.length}</small></a
      >{
        categories.map((c) => (
          <a
            href={href('category', c.slug)}
            class:list={{ active: params.get('category') === c.slug }}
            data-filter-link
          >
            <span>{c.emoji}</span>
            {c.name}
            <small>{apps.filter((a) => a.category === c.slug).length}</small>
          </a>
        ))
      }
    </nav>
  </aside><section class="directory-main">
    <div class="directory-head">
      <h2>대체 인증 순위<span class="count-label">{r.total} TOOLS</span></h2><a
        href="/suggest"
        class="small muted">찾는 도구가 없나요? +</a
      >
    </div><form id="filters" class="filters" action="/">
      <input type="hidden" name="q" value={params.get('q') || ''} /><input
        type="hidden"
        name="category"
        value={params.get('category') || ''}
      /><select name="verdict" aria-label="대체 판정"
        ><option value="">모든 판정</option>{
          [
            ['yes', '↗ 대체 가능'],
            ['kinda', '≈ 일부 가능'],
            ['no', '× 대체 어려움'],
          ].map(([k, v]) => (
            <option value={k} selected={params.get('verdict') === k}>
              {v}
            </option>
          ))
        }</select
      ><select name="type" aria-label="도구 유형"
        ><option value="">모든 유형</option>{
          [
            ['saas', '웹 서비스'],
            ['desktop', '데스크톱'],
            ['local-first', '로컬 우선'],
            ['open-source', '오픈소스'],
          ].map(([k, v]) => (
            <option value={k} selected={params.get('type') === k}>
              {v}
            </option>
          ))
        }</select
      ><select name="price" aria-label="가격 모델"
        ><option value="">모든 가격</option>{
          [
            ['free', '무료'],
            ['freemium', '무료+유료'],
            ['subscription', '구독형'],
            ['one-time', '일회성 구매'],
            ['usage-based', '사용량형'],
            ['contact-sales', '견적형'],
          ].map(([k, v]) => (
            <option value={k} selected={params.get('price') === k}>
              {v}
            </option>
          ))
        }</select
      ><select name="sort" aria-label="정렬"
        ><option value="popular" selected={!params.get('sort') || params.get('sort') === 'popular'}
          >대체 인증순 ↓</option
        ><option value="newest" selected={params.get('sort') === 'newest'}>최신 확인순</option><option
          value="price"
          selected={params.get('sort') === 'price'}>월 비용 낮은순</option
        ></select
      ><noscript><button type="submit">적용</button></noscript>
    </form><div class="tool-table-head">
      <span>도구 / 카테고리</span><span>기준 비용</span><span>바이브코딩 판정</span><span>인증</span>
    </div><div aria-live="polite" aria-label="검색 결과">
      {r.items.map((a) => <ToolRow app={a} count={counts[a.slug] || 0} />)}{
        !r.items.length && (
          <div class="empty">
            <>
              <h3>아직 일치하는 도구가 없어요.</h3>
              <p>다른 이름으로 검색하거나 새로운 도구를 제안해 주세요.</p>
              <a href="/suggest" class="button secondary">
                도구 제안하기
              </a>
            </>
          </div>
        )
      }
    </div><nav class="pagination" aria-label="페이지 이동">
      {
        Array.from({ length: r.pages }, (_, i) => i + 1).map((p) => (
          <a
            href={
              '/?' +
              new URLSearchParams({ ...Object.fromEntries(params), page: String(p) }).toString() +
              '#directory'
            }
            class:list={{ active: p === r.page }}
            aria-current={p === r.page ? 'page' : undefined}
            data-filter-link
          >
            {p}
          </a>
        ))
      }
    </nav>
  </section>
</div>
