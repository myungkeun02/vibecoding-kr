# A: 로컬 필수. SESSION_SECRET 미설정 시 DATA_DIR 안에 비공개 무작위 키 자동 생성.
SITE_URL=http://localhost:8095
# PostgreSQL 필수. Railway에서는 PostgreSQL 서비스의 DATABASE_URL 참조
DATABASE_URL=postgresql://user:password@localhost:5432/vibepan
DATABASE_POOL_MAX=5
DATA_DIR=data/private
HOST=127.0.0.1
PORT=8095
APP_ENV=development
# B: 운영은 APP_ENV=production, HTTPS SITE_URL, 절대 DATA_DIR, 32자 이상 키 필수
SESSION_SECRET=
# 신뢰할 수 있는 단일 reverse proxy에서만 1로 설정
TRUST_PROXY=0
# C: 선택 OAuth, 이메일, 카카오 공유, 저장소
# 공급자에 등록할 callback: SITE_URL/api/auth/callback/github 또는 /google
# 등록한 로컬 주소가 localhost:4321이면 SITE_URL과 PORT를 함께 변경
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_URL=
MAIL_FROM=
RESEND_API_KEY=
KAKAO_JAVASCRIPT_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 검토된 제안의 초안 PR 발행용 서버/운영 CLI 전용 (선택)
GITHUB_REPOSITORY=
GITHUB_BOT_FORK=
GITHUB_BOT_TOKEN=
